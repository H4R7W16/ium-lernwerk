---
import type { StoragePlatformState } from '../controllers/platform-state.js';

interface Props {
  mode?: StoragePlatformState;
}

const { mode = 'volatile-selected' } = Astro.props;
const labels = {
  persistent: 'Dauerhaft lokal gespeichert',
  'volatile-selected': 'Nur für diese Sitzung',
  'volatile-fallback': 'Dauerhaftes Speichern nicht verfügbar',
} as const;
---

<section class="status-card" aria-labelledby="storage-status-title" data-platform-fact="storage" data-storage-mode={mode}>
  <h2 id="storage-status-title">Speicherstatus</h2>
  <p aria-live="polite" data-storage-status>{labels[mode]}</p>
</section>
