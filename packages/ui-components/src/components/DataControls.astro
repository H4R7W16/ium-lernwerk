<section aria-labelledby="data-controls-title">
  <h2 id="data-controls-title">Lokale Daten</h2>
  <p>Du kannst deinen Arbeitsstand exportieren, importieren oder bewusst löschen.</p>
  <div class="actions" data-controls>
    <button type="button" data-export-state>Arbeitsstand exportieren</button>
    <label class="file-action">
      Arbeitsstand importieren
      <input type="file" accept="application/json,.json" data-import-state />
    </label>
    <button type="button" class="danger" data-delete-state>Arbeitsstand löschen</button>
  </div>
</section>
