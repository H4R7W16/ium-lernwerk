<section
  class="update-prompt"
  aria-labelledby="update-title"
  data-update-prompt
  hidden
  tabindex="-1"
>
  <h2 id="update-title">Aktualisierung verfügbar</h2>
  <p>Speichere zuerst deinen Arbeitsstand und entscheide dann bewusst.</p>
  <div class="actions">
    <button type="button" data-update-confirm>Speichern und aktualisieren</button>
    <button type="button" data-update-dismiss>Später</button>
  </div>
</section>
