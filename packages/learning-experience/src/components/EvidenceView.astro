<section class="lx-evidence-view" aria-labelledby="trace-title">
  <h3 id="trace-title">Laufspur prüfen</h3>
  <div class="table-scroll" role="region" aria-label="Laufspur horizontal scrollen" tabindex="0">
    <table aria-label="Laufspur" data-trace-table>
      <caption>Laufspur mit Schritt, Befehl, Vorherzustand, Nachherzustand und Ergebnis</caption>
      <thead>
        <tr>
          <th scope="col">Schritt</th><th scope="col">Befehl</th><th scope="col">Iteration</th>
          <th scope="col">Vorherzustand</th><th scope="col">Nachherzustand</th><th scope="col">Ergebnis</th>
        </tr>
      </thead>
      <tbody><tr><td colspan="6">Noch keine Spur vorhanden.</td></tr></tbody>
    </table>
  </div>
  <fieldset aria-describedby="evidence-selection-help">
    <legend>Erster abweichender Schritt</legend>
    <p id="evidence-selection-help">Wähle die erste Zeile, die deine Deutung trägt.</p>
    <p data-evidence-options>Noch keine Spur zur Auswahl.</p>
  </fieldset>
</section>
