{
  "name": "ium-lernwerk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "contracts:generate": "tsx scripts/generate-contract-types.ts",
    "contracts:check": "npm run contracts:generate && tsx scripts/generate-contract-types.ts --check",
    "registry:production": "tsx scripts/build-module-registry.ts production",
    "registry:fixture": "tsx scripts/build-module-registry.ts fixture",
    "registry:v2": "tsx scripts/build-v2-module-registry.ts",
    "boundaries:check": "tsx scripts/check-workspace-boundaries.ts",
    "assets:pwa": "tsx scripts/generate-pwa-assets.ts",
    "build": "tsx scripts/build-portal.ts production development /",
    "build:gate-b-preview": "tsx scripts/build-portal.ts production gate-b-preview /ium-lernwerk/",
    "build:fixture": "tsx scripts/build-portal.ts fixture device-fixture /",
    "build:fixture:subpath": "tsx scripts/build-portal.ts fixture device-fixture /ium-lernwerk/",
    "build:v2": "tsx scripts/build-portal.ts v2-development development /",
    "build:v2:subpath": "tsx scripts/build-portal.ts v2-development development /ium-lernwerk/",
    "check:astro": "tsx scripts/check-astro.ts",
    "preview:fixture": "tsx scripts/preview-portal.ts fixture device-fixture / 4321",
    "preview:ium5": "tsx scripts/preview-portal.ts production development / 4322",
    "preview:gate-b": "tsx scripts/preview-portal.ts production gate-b-preview /ium-lernwerk/ 4323",
    "preview:v2": "tsx scripts/preview-portal.ts v2-development development / 4324",
    "quality:build": "tsx scripts/check-build-output.ts",
    "quality:licenses": "tsx scripts/check-dependency-licenses.ts",
    "test:browser": "playwright test tests/browser/platform.spec.ts",
    "test:accessibility": "playwright test tests/browser/accessibility.spec.ts --project=chromium",
    "test:offline": "playwright test tests/browser/offline.spec.ts --project=chromium",
    "test:ium5:browser": "playwright test tests/browser/ium5-workbench.spec.ts --config playwright.ium5.config.mts",
    "test:ium5:state": "playwright test tests/browser/ium5-state.spec.ts --config playwright.ium5.config.mts --project=chromium",
    "test:ium5:accessibility": "playwright test tests/browser/ium5-accessibility.spec.ts --config playwright.ium5.config.mts --project=chromium",
    "test:ium5:offline": "playwright test tests/browser/ium5-offline.spec.ts --config playwright.ium5.config.mts --project=chromium",
    "test:v2:m06": "tsx scripts/verify-v2-m06.ts --browser all",
    "test:v2:m06:workbench": "tsx scripts/verify-v2-m06.ts --browser tests/browser/v2-m06-workbench.spec.ts",
    "test:v2:m06:state": "tsx scripts/verify-v2-m06.ts --browser tests/browser/v2-m06-state.spec.ts",
    "test:v2:m06:accessibility": "tsx scripts/verify-v2-m06.ts --browser tests/browser/v2-m06-accessibility.spec.ts",
    "test:v2:m06:offline": "tsx scripts/verify-v2-m06.ts --browser tests/browser/v2-m06-offline.spec.ts",
    "typecheck": "npm run contracts:generate && tsc -b --pretty false",
    "test:platform": "npm run contracts:generate && vitest run",
    "test:python": "python -B -m unittest discover -s tests -p \"test_*.py\"",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "verify:ium5": "tsx scripts/verify-ium5.ts",
    "verify:v2": "python -B scripts/validate_v2_rebaseline.py",
    "verify:v2:active": "npm run verify:v2:implementation",
    "verify:v2:cutover": "npm run verify:v2 && npm run verify:v2:implementation",
    "verify:v2:sources:online": "python -B scripts/check_v2_source_links.py --write",
    "verify:ium5:gate-b": "tsx scripts/verify-ium5-gate-b.ts",
    "dashboard:check": "node scripts/project-dashboard.mjs check",
    "dashboard:update": "node scripts/project-dashboard.mjs update",
    "dashboard:build": "node scripts/project-dashboard.mjs build",
    "dashboard:preview": "node scripts/project-dashboard.mjs preview",
    "test:dashboard": "node --test tests/dashboard/*.test.mjs",
    "test:dashboard:browser": "node scripts/test-dashboard-browser.mjs",
    "verify:v2:implementation": "python -B scripts/validate_v2_implementation.py",
    "verify:v2:activation:historical": "python -B scripts/validate_v2_implementation.py --historical-only",
    "verify:v2:m06": "tsx scripts/verify-v2-m06.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@vite-pwa/assets-generator": "1.0.2",
    "astro": "7.1.6",
    "fake-indexeddb": "6.2.5",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@vite-pwa/assets-generator": {
      "sharp": "0.35.3"
    }
  }
}
