  "captions": [
    {
      "scene": "A01",
      "start": 0.5,
      "end": 3.17,
      "text": "Lea fragt: Leuchtet der Mond selbst?"
    },
    {
      "scene": "A01",
      "start": 3.925,
      "end": 7.07,
      "text": "Sie möchte herausfinden, woher das Licht kommt."
    },
    {
      "scene": "A02",
      "start": 9.133,
      "end": 11.728,
      "text": "Der Browser ist ein Programm für Webseiten."
    },
    {
      "scene": "A02",
      "start": 12.471,
      "end": 16.553,
      "text": "Die Suchmaschine fragFINN hilft beim Finden von Webseiten."
    },
    {
      "scene": "A02",
      "start": 17.296,
      "end": 18.941,
      "text": "Hier ist das Suchfeld."
    },
    {
      "scene": "A03",
      "start": 21.033,
      "end": 22.541,
      "text": "Lea sucht nach Mond."
    },
    {
      "scene": "A03",
      "start": 23.283,
      "end": 25.941,
      "text": "Ihre eingegebenen Wörter heißen Suchwörter."
    },
    {
      "scene": "A03",
      "start": 26.683,
      "end": 28.803,
      "text": "Ein Treffer ist ein Suchergebnis."
    },
    {
      "scene": "A03",
      "start": 29.558,
      "end": 32.153,
      "text": "Der erste Titel handelt vom blauen Mond."
    },
    {
      "scene": "A04",
      "start": 34.233,
      "end": 36.291,
      "text": "Welches Wort würdest du ergänzen?"
    },
    {
      "scene": "A05",
      "start": 44.567,
      "end": 46.237,
      "text": "Lea ergänzt leuchtet."
    },
    {
      "scene": "A05",
      "start": 46.979,
      "end": 51.662,
      "text": "Auch jetzt passt der erste Titel noch nicht: Er handelt von\neiner Mondfinsternis."
    },
    {
      "scene": "A05",
      "start": 52.417,
      "end": 54.162,
      "text": "Lea liest weitere Treffer."
    },
    {
      "scene": "A06",
      "start": 56.567,
      "end": 61.262,
      "text": "Weiter unten findet Lea einen passenden Titel: Warum leuchtet\nder Mond?"
    },
    {
      "scene": "A06",
      "start": 62.004,
      "end": 63.299,
      "text": "Sie klickt ihn an."
    },
    {
      "scene": "A06",
      "start": 64.054,
      "end": 66.987,
      "text": "Bei deiner Suche können andere Treffer erscheinen."
    },
    {
      "scene": "A07",
      "start": 69.567,
      "end": 71.724,
      "text": "Jetzt ist Frag Sophie geöffnet."
    },
    {
      "scene": "A07",
      "start": 72.467,
      "end": 74.549,
      "text": "Diese Seite ist Leas Quelle."
    },
    {
      "scene": "A07",
      "start": 75.292,
      "end": 77.874,
      "text": "Lea liest im Text unter dem Comic nach."
    },
    {
      "scene": "A08",
      "start": 79.967,
      "end": 82.699,
      "text": "Eine Textstelle ist ein Teil des Textes."
    },
    {
      "scene": "A08",
      "start": 83.454,
      "end": 85.774,
      "text": "Hier stehen zwei kurze Auszüge."
    },
    {
      "scene": "A08",
      "start": 86.517,
      "end": 89.062,
      "text": "Angestrahlt heißt: Licht fällt darauf."
    },
    {
      "scene": "A08",
      "start": 89.804,
      "end": 91.812,
      "text": "Ein Teleskop ist ein Fernrohr."
    },
    {
      "scene": "A09",
      "start": 99.967,
      "end": 101.637,
      "text": "Welche Stelle hilft Lea?"
    },
    {
      "scene": "A09",
      "start": 102.379,
      "end": 103.562,
      "text": "Zeige die Wörter."
    },
    {
      "scene": "A09",
      "start": 104.304,
      "end": 106.012,
      "text": "Warum hilft die andere nicht?"
    },
    {
      "scene": "A10",
      "start": 114.267,
      "end": 115.362,
      "text": "Lea wählt A."
    },
    {
      "scene": "A10",
      "start": 116.104,
      "end": 120.687,
      "text": "Dort steht, dass der Mond nicht selbst leuchtet und Licht von\nder Sonne bekommt."
    },
    {
      "scene": "A10",
      "start": 121.429,
      "end": 124.924,
      "text": "B erklärt, was man mit einem Fernrohr beobachten kann."
    },
    {
      "scene": "A11",
      "start": 128.267,
      "end": 130.399,
      "text": "Lea sagt es mit eigenen Worten."
    },
    {
      "scene": "A11",
      "start": 131.142,
      "end": 133.187,
      "text": "Der Mond wirft Sonnenlicht zurück."
    },
    {
      "scene": "A11",
      "start": 133.929,
      "end": 136.462,
      "text": "Dieses Zurückwerfen nennt man Reflexion."
    },
    {
      "scene": "A11",
      "start": 137.204,
      "end": 139.224,
      "text": "Dann schreibt sie ihre Antwort auf."
    },
    {
      "scene": "A12",
      "start": 143.267,
      "end": 148.887,
      "text": "Lea notiert auch die passende Stelle: erster Textabsatz unter\ndem Comic, erster Satz."
    },
    {
      "scene": "A12",
      "start": 149.629,
      "end": 152.637,
      "text": "So weiß sie später, wo ihre Antwort herkommt."
    },
    {
      "scene": "A13",
      "start": 154.7,
      "end": 156.407,
      "text": "Oben steht die Webadresse."
    },
    {
      "scene": "A13",
      "start": 157.15,
      "end": 159.333,
      "text": "Lea kopiert sie in ihre Notiz."
    },
    {
      "scene": "A13",
      "start": 160.075,
      "end": 162.558,
      "text": "Ein anklickbarer Verweis heißt Link."
    },
    {
      "scene": "A13",
      "start": 163.3,
      "end": 165.107,
      "text": "Der Seitenname kommt dazu."
    },
    {
      "scene": "A14",
      "start": 168.7,
      "end": 171.045,
      "text": "Lea öffnet ihren gespeicherten Link."
    },
    {
      "scene": "A14",
      "start": 171.787,
      "end": 174.482,
      "text": "Sie findet die Seite und den ersten Satz wieder."
    },
    {
      "scene": "A14",
      "start": 175.225,
      "end": 177.558,
      "text": "Ihre Notiz hilft ihr beim Nachlesen."
    },
    {
      "scene": "A15",
      "start": 179.7,
      "end": 181.87,
      "text": "Jetzt suchst du zu rund und Sichel."
    },
    {
      "scene": "A15",
      "start": 182.612,
      "end": 185.308,
      "text": "Leas Lichtantwort genügt dafür noch nicht."
    }
  ]
