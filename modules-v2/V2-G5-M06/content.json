  "helps": [
    {"id":"H1","trigger":"Ort oder Blickrichtung wird verwechselt.","learnerText":"Markiere zuerst das aktuelle Feld und zeichne einen Pfeil für die Blickrichtung. Ändere bei einer Drehung nur den Pfeil.","ownFollowUp":"Sage den nächsten Zustand voraus und prüfe genau einen Schritt.","fade":"Blende die Hilfe nach einem selbst richtig erklärten Zustandswechsel wieder aus."},
    {"id":"H2","trigger":"Nur ein Teil des Wiederholungskörpers wird wiederholt.","learnerText":"Rahme alle Anweisungen ein, die in jedem Durchlauf zusammengehören. Die Anzahl steht vor diesem ganzen Rahmen.","ownFollowUp":"Entfalte zwei vollständige Durchläufe mit deinen eigenen Anweisungen.","fade":"Entferne die Markierung, sobald du Körper und Anzahl ohne Vorlage erklären kannst."},
    {"id":"H3","trigger":"Fehlermeldung und erste fachliche Abweichung werden gleichgesetzt.","learnerText":"Vergleiche Soll und Ist ab Schritt 1. Markiere den ersten unterschiedlichen Zustand, auch wenn die Fehlermeldung später erscheint.","ownFollowUp":"Ändere eine begründete Stelle und prüfe erneut vom gleichen Start.","fade":"Schließe die Hilfe nach der eigenen Revisionsbegründung."},
    {"id":"H4","trigger":"Eingabe, Sprache oder Bedienweg verhindert die fachliche Arbeit.","learnerText":"Nutze die Befehlslegende, Tastaturbedienung oder lineare Textform. Lies Körper und Anzahl in der Reihenfolge vor.","ownFollowUp":"Gib selbst einen Befehl ein oder ordne ihn um und erkläre seine Wirkung.","fade":"Wechsle zurück zur knappen Legende, sobald der eigene Eingabeschritt gelingt."}
  ]
