{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/H4R7W16/ium-lernwerk/schemas/v2/curriculum-source-basis.schema.json",
  "title": "IuM-Lernwerk V2 CurriculumSourceBasisV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "asOf",
    "baseline",
    "sources",
    "totals",
    "crosswalk",
    "coverageAudit",
    "decisionBasis",
    "statementBoundaries"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectId": {"const": "ium-lernwerk"},
    "asOf": {"type": "string", "format": "date"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commit", "immutablePaths"],
      "properties": {
        "status": {"const": "v1-audit-input"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "immutablePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "title",
          "binding",
          "normativeStatus",
          "repositoryPath",
          "datasetSha256",
          "sourceAssetSha256",
          "recordCount",
          "grades",
          "checkedAt",
          "currentReview"
        ],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "binding": {"enum": ["official", "orientation"]},
          "normativeStatus": {"enum": ["enacted", "orientation"]},
          "repositoryPath": {"type": "string", "minLength": 1},
          "datasetSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
          "sourceAssetSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
          "recordCount": {"type": "integer", "minimum": 1},
          "grades": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": [5, 6, 7]}
          },
          "checkedAt": {"type": "string", "format": "date"},
          "currentReview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkedAt",
              "status",
              "landingPageUrl",
              "directUrl",
              "contentIdentity",
              "remoteSha256",
              "remoteByteLength",
              "finding"
            ],
            "properties": {
              "checkedAt": {"type": "string", "format": "date"},
              "status": {
                "enum": ["transition-status-rechecked", "direct-source-rechecked"]
              },
              "landingPageUrl": {"type": "string", "format": "uri"},
              "directUrl": {"type": "string", "format": "uri"},
              "contentIdentity": {"enum": ["not-byte-compared", "sha256-match"]},
              "remoteSha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9A-F]{64}$"
              },
              "remoteByteLength": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "finding": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordCount", "uniqueRecordCount"],
      "properties": {
        "recordCount": {"const": 278},
        "uniqueRecordCount": {"const": 278}
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryPath",
        "datasetSha256",
        "status",
        "recordCount",
        "relationCount",
        "unmappedRecordCount",
        "relationshipCounts"
      ],
      "properties": {
        "repositoryPath": {"const": "curriculum/crosswalk.json"},
        "datasetSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "status": {"const": "v1-audit-input"},
        "recordCount": {"const": 278},
        "relationCount": {"const": 56},
        "unmappedRecordCount": {"const": 107},
        "relationshipCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["equivalent", "extends", "new", "not-comparable", "overlaps", "reframes"],
          "properties": {
            "equivalent": {"const": 2},
            "extends": {"const": 15},
            "new": {"const": 3},
            "not-comparable": {"const": 4},
            "overlaps": {"const": 15},
            "reframes": {"const": 17}
          }
        }
      }
    },
    "coverageAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryPath", "datasetSha256", "status", "entryCount", "byBinding"],
      "properties": {
        "repositoryPath": {"const": "roadmap/coverage-plan.json"},
        "datasetSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "status": {"const": "v1-audit-input"},
        "entryCount": {"const": 171},
        "byBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official", "orientation"],
          "properties": {
            "official": {"$ref": "#/$defs/coverageCount"},
            "orientation": {"$ref": "#/$defs/coverageCount"}
          }
        }
      }
    },
    "decisionBasis": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidencePointer"}
    },
    "statementBoundaries": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "coverageCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "partial", "total"],
      "properties": {
        "covered": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "evidencePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "label", "required"],
      "properties": {
        "kind": {"enum": ["repo", "git", "vault", "url", "doi"]},
        "target": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    }
  }
}
