{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/H4R7W16/ium-lernwerk/schemas/v2/learning-evidence.schema.json",
  "title": "IuM-Lernwerk V2 learning evidence register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "mechanism",
        "scope",
        "learnerContext",
        "boundaryConditions",
        "sourceIds",
        "evidenceLevel",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLAIM-[A-Z0-9-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "learnerContext": {
          "type": "string",
          "minLength": 1
        },
        "boundaryConditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          }
        },
        "evidenceLevel": {
          "enum": [
            "low",
            "medium",
            "high",
            "normative"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "working",
            "reviewed",
            "standard"
          ]
        }
      }
    }
  }
}
