{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ium-lernwerk.de/schemas/v2/implementation.schema.json",
  "title": "Controlled V2 implementation records",
  "anyOf": [
    {
      "$ref": "#/$defs/authorization"
    },
    {
      "$ref": "#/$defs/changePlan"
    },
    {
      "$ref": "#/$defs/progress"
    }
  ],
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentProduction",
        "curriculum",
        "usage",
        "pilot",
        "publication",
        "push",
        "merge",
        "lxp05"
      ],
      "properties": {
        "contentProduction": {
          "const": "frozen"
        },
        "curriculum": {
          "const": "unassessed"
        },
        "usage": {
          "const": "not-started"
        },
        "pilot": {
          "const": "not-started"
        },
        "publication": {
          "const": "closed"
        },
        "push": {
          "const": "not-authorized"
        },
        "merge": {
          "const": "not-authorized"
        },
        "lxp05": {
          "const": "frozen-unmerged"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decisionBy",
        "date",
        "statement"
      ],
      "properties": {
        "state": {
          "const": "approved-by-user"
        },
        "decisionBy": {
          "const": "user"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "decisionBy",
        "statement",
        "packageIds",
        "optionalChanges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "decisionBy": {
          "const": "user"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "packageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^IMP0[1-8]$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "optionalChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packageId",
        "files",
        "dependsOn"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packageId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^IMP0[1-8]$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "exitCode",
        "scope",
        "baseCommit",
        "treeDigest",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "const": "synthetic-contract"
        },
        "baseCommit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "treeDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decisionBy",
        "date",
        "statement",
        "acceptedCommit"
      ],
      "properties": {
        "state": {
          "const": "approved-by-user"
        },
        "decisionBy": {
          "const": "user"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "acceptedCommit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "acceptedPlanCommit",
        "planAcceptance",
        "requests",
        "limits"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectId": {
          "const": "ium-lernwerk"
        },
        "acceptedPlanCommit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "planAcceptance": {
          "$ref": "#/$defs/approval"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          },
          "minItems": 1
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "changePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "acceptedPlanCommit",
        "sourcePath",
        "historicalActivationCommit",
        "packages",
        "sharedStatusFiles"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectId": {
          "const": "ium-lernwerk"
        },
        "acceptedPlanCommit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourcePath": {
          "const": "roadmap/v2/implementation-planning/plan.json"
        },
        "historicalActivationCommit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          },
          "minItems": 8
        },
        "sharedStatusFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "moduleId",
        "updated",
        "packages",
        "limits"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectId": {
          "const": "ium-lernwerk"
        },
        "moduleId": {
          "const": "V2-G5-M06"
        },
        "updated": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state",
              "candidateCommit",
              "checks",
              "acceptance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^IMP0[1-8]$"
              },
              "state": {
                "enum": [
                  "planned",
                  "in_progress",
                  "review",
                  "done"
                ]
              },
              "candidateCommit": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{40}$"
                  }
                ]
              },
              "checks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/check"
                },
                "minItems": 0
              },
              "acceptance": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/completion"
                  }
                ]
              }
            }
          },
          "minItems": 8
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  }
}
