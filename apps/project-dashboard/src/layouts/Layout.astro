---
import { snapshot as s, pages } from '../data.mjs';
import '../styles.css';
const { title, page = '' } = Astro.props;
---
<!doctype html>
<html lang="de">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Lokales Projektcockpit des IuM-Lernwerks mit getrennten Reifeachsen und überprüfbaren Belegen."/><title>{title} · IuM-Lernwerk</title></head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt</a>
  <aside class="sidebar" aria-label="Projekt-Navigation">
    <a href="/" class="brand"><span class="mark" aria-hidden="true">IuM</span><span>Lernwerk<small>Projektcockpit · V2</small></span></a>
    <p class="nav-caption">ENTWICKLUNG</p>
    <nav aria-label="Bereiche"><ul>{pages.map(([slug,label],i)=><li><a href={`/${slug}${slug?'/':''}`} aria-current={page===slug?'page':undefined}><span class="nav-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>{label}</a></li>)}</ul></nav>
    <div class="sidebar-note"><span class="dot" aria-hidden="true"></span><strong>V2 im Aufbau</strong><p>Aktive Baseline: V1<br/>Produktion geschlossen</p></div>
  </aside>
  <div class="shell">
    <header class="topbar"><span>INFORMATIK & MEDIENBILDUNG <span class="desktop-only">/ GYMNASIUM 5–7</span></span><span class="mode">{s.mode==='presentation'?'Lokale Präsentation':'Interne Arbeitsansicht'}</span></header>
    <main id="inhalt" tabindex="-1"><p class="print-only print-meta">IuM-Lernwerk · {s.asOf} · Stand {s.git.head} · {s.git.dirty?'Arbeitskopie verändert':'Arbeitskopie sauber'}</p><slot/></main>
    <footer><span>Stichtag {s.asOf} · Planungsstand ohne Einsatzfreigabe</span><span>Stand <code>{s.git.head.slice(0,12)}</code> · {s.git.dirty?'Arbeitskopie verändert':'Arbeitskopie sauber'}</span><a href="/evidence/">Provenienz und Aktualität</a></footer>
  </div>
</body>
</html>
