---
import type { WorkbenchResources } from '@ium/ium-5-core-05';
import type { ExperienceContentV1 } from '@ium/learning-experience';
import ActionEdge from '@ium/learning-experience/components/ActionEdge';
import ContextBand from '@ium/learning-experience/components/ContextBand';
import DataActionDialog from '@ium/learning-experience/components/DataActionDialog';
import EvidenceFeedback from '@ium/learning-experience/components/EvidenceFeedback';
import EvidenceCardComposer from '@ium/learning-experience/components/EvidenceCardComposer';
import EvidenceView from '@ium/learning-experience/components/EvidenceView';
import ExperienceShell from '@ium/learning-experience/components/ExperienceShell';
import FocusStage from '@ium/learning-experience/components/FocusStage';
import JourneyMap from '@ium/learning-experience/components/JourneyMap';
import PredictionForm from '@ium/learning-experience/components/PredictionForm';
import RecoveryPanel from '@ium/learning-experience/components/RecoveryPanel';
import ResumePrompt from '@ium/learning-experience/components/ResumePrompt';
import RevisionCompare from '@ium/learning-experience/components/RevisionCompare';
import ReentryRecall from '@ium/learning-experience/components/ReentryRecall';
import SemanticModelView from '@ium/learning-experience/components/SemanticModelView';
import SharedHold from '@ium/learning-experience/components/SharedHold';
import StartBoard from '@ium/learning-experience/components/StartBoard';
import SupportDisclosure from '@ium/learning-experience/components/SupportDisclosure';
import TeacherCheckpoint from '@ium/learning-experience/components/TeacherCheckpoint';
import TransferPrompt from '@ium/learning-experience/components/TransferPrompt';
import RoleExchange from '@ium/learning-experience/components/RoleExchange';
import workbenchStyles from '../styles/algorithm-workbench.css?raw';

interface Props {
  moduleId: string;
  moduleVersion: string;
  resources: Readonly<{
    content: WorkbenchResources['content'];
    scenarios: WorkbenchResources['scenarios'];
    robotAssetPath: string;
  }>;
  experience?: ExperienceContentV1;
}

const { moduleId, moduleVersion, resources, experience } = Astro.props;
const base = import.meta.env.PUBLIC_IUM_BASE_PATH ?? import.meta.env.BASE_URL;
const robotAssetUrl = `${base}${resources.robotAssetPath}`;
const firstScenario = resources.scenarios[0]?.scenario;
const positions = Array.from({ length: 6 }, (_, row) =>
  Array.from({ length: 6 }, (_entry, column) =>
    `${String.fromCharCode(65 + column)}${row + 1}`,
  ),
).flat();
const resourceJson = JSON.stringify(resources).replace(
  /[<>&\u2028\u2029]/g,
  (character) => `\\u${character.codePointAt(0)?.toString(16).padStart(4, '0')}`,
);
const phaseLabels: Readonly<Record<string, string>> = {
  'ue1-orientation': 'UE 1 · Einstieg',
  'ue1-prior-knowledge': 'UE 1 · Vorwissen',
  'ue1-concept': 'UE 1 · Begriff',
  'ue2-concept': 'UE 2 · Zustände',
  'ue2-guided': 'UE 2 · Vorhersage',
  'ue3-guided': 'UE 3 · Fehlersuche',
  'ue3-product': 'UE 3 · Entwurf',
  'ue4-product': 'UE 4 · Ausführung',
  'ue4-revision': 'UE 4 · Revision',
  'ue5-transfer': 'UE 5 · Transfer',
  'ue5-consolidation': 'UE 5 · Sicherung',
  'ue6-extension': 'UE 6 · Erweiterung',
};
const transferLabels: Readonly<Record<string, string>> = {
  navigation: 'Navigation',
  'search-service': 'Suchdienst',
  'digital-timetable': 'Digitale Stundenplananzeige',
  'paper-map': 'Papierkarte',
  'mechanical-timer': 'Mechanischer Kurzzeitwecker',
  'controlled-vehicle': 'Steuerbares Fahrzeug',
};
const selfCheckLabels: Readonly<Record<string, string>> = {
  'unambiguous-instruction': 'Sind alle Anweisungen eindeutig?',
  'trace-matches-prediction': 'Passt die Laufspur zur Vorhersage?',
  'repair-follows-evidence': 'Ist die Reparatur durch die Belegspur begründet?',
  'repeat-is-appropriate': 'Ist die feste Wiederholung passend?',
};
const journeyItems = resources.content.segments.map((segment, index) => ({
  id: segment.id,
  label: phaseLabels[segment.id],
  current: index === 0,
  hidden: segment.id === 'ue6-extension',
  action: {
    value: segment.id,
    title: segment.title,
    description: segment.learningFunction,
  },
}));
const startSpec = experience?.start ?? {
  heading: 'Algorithmen untersuchen',
  guidingQuestion: resources.content.centralQuestion,
  expectedCapability: 'Du entwirfst, prüfst und revidierst einen eindeutigen Ablauf.',
  timeWindowMinutes: [10, 15] as const,
  socialForm: 'individual' as const,
  primaryAction: {
    label: 'Mit der Vermutung beginnen',
    result: 'Öffnet die erste Denkhandlung.',
  },
  resumeAction: null,
  resetAction: null,
};
const initialSceneDescription = firstScenario
  ? `Raster ${firstScenario.width} mal ${firstScenario.height}. Start Spalte ${firstScenario.start.position.column}, Zeile ${firstScenario.start.position.row}, Blickrichtung ${firstScenario.start.direction}. Gut bei Spalte ${firstScenario.itemPosition.column}, Zeile ${firstScenario.itemPosition.row}. Ziel bei Spalte ${firstScenario.targetPosition.column}, Zeile ${firstScenario.targetPosition.row}. Hindernisse werden mit Koordinaten genannt.`
  : 'Keine validierte Szene verfügbar.';
const evidenceSourceOptions = resources.scenarios.map((entry) => ({
  value: entry.scenario.id,
  label: entry.scenario.title,
}));
const evidenceReferenceOptions = [
  { value: 'trace:first-deviation', label: 'Erste Abweichung in der Laufspur' },
  { value: 'trace:complete', label: 'Vollständige Laufspur' },
] as const;
const transferCases = resources.content.transferCases.map((transferCase) => ({
  ...transferCase,
  label: transferLabels[transferCase.id],
}));
const comparisonCheckpoint = experience?.checkpoints.find((entry) => entry.id === 'checkpoint-comparison');
const transferCheckpoint = experience?.checkpoints.find((entry) => entry.id === 'checkpoint-transfer');
---

<section
  class="algorithm-workbench"
  aria-label="Algorithmus-Werkstatt"
  aria-busy="true"
  inert
  data-algorithm-workbench
  data-initialization-state="initializing"
  data-module-id={moduleId}
  data-module-version={moduleVersion}
  data-experience-contract={experience?.schemaVersion}
>
  <style is:inline set:html={workbenchStyles}></style>
  <div data-experience-entry>
    <StartBoard spec={startSpec} headingLevel="h2" />
    <ResumePrompt
      heading={startSpec.heading}
      headingLevel="h2"
      stageLabel="Vorhersage bilden"
      resumePurpose={startSpec.resumeAction?.purpose ?? 'Setzt am letzten bestätigten Lernschritt fort.'}
      resetConsequence={startSpec.resetAction?.consequence ?? 'Entfernt nach Bestätigung nur diesen Modulstand.'}
    />
    <div data-start-recovery hidden>
      <RecoveryPanel
        heading="Lokalen Arbeitsstand wiederherstellen"
        preservedState="Die aktuelle Ansicht bleibt verfügbar; ein bestätigter Stand wird nicht still überschrieben."
        resetDialogId="start-reset-dialog"
      />
    </div>
    <DataActionDialog
      id="start-reset-dialog"
      action="reset"
      title="Diesen Modulstand neu beginnen?"
      description={startSpec.resetAction?.consequence ?? 'Der lokale Stand dieses Moduls wird entfernt.'}
      confirmLabel="Modulstand endgültig zurücksetzen"
    />
  </div>
  <div data-experience-content hidden>
  <ExperienceShell ariaLabel="Algorithmus-Lernstudio">
    <ContextBand
      slot="context"
      items={[
        { term: 'Modul', value: 'Präzise Abläufe ausführbar machen' },
        { term: 'Arbeitsweise', value: 'Local First · ohne Konto' },
      ]}
    />
    <JourneyMap slot="journey" items={journeyItems} ariaLabel="Lernphasen" />
    <FocusStage
      slot="focus"
      id="workbench-title"
      heading="Auftrag und Lernziel"
      purpose={resources.content.centralQuestion}
      focusOnActivation={false}
    >
  <p class="working-banner" role="status">
    Arbeitsstand · Status working · nicht für Unterrichtseinsatz
  </p>
  <header class="workbench-intro">
    <p class="eyebrow">Hybride Algorithmus-Werkstatt · Klasse 5</p>
    <p>
      Baue einen eindeutigen Lieferalgorithmus, sage seine Ausführung voraus,
      prüfe die Laufspur und begründe eine gezielte Revision.
    </p>
    <p><strong data-path-summary>225 Minuten · 5 Unterrichtseinheiten</strong></p>
  </header>

  <section aria-labelledby="active-phase-title" data-active-phase>
    <h3 id="active-phase-title" tabindex="-1" data-active-phase-heading>
      {resources.content.segments[0]?.title}
    </h3>
    <p data-active-phase-function>{resources.content.segments[0]?.learningFunction}</p>
  </section>

  <section aria-labelledby="task-families-title">
    <h3 id="task-families-title">Aufgabenfamilien</h3>
    <div class="command-palette">
      <button type="button" data-task-family-open="precision">Präzisionskontrast öffnen</button>
      <button type="button" data-task-family-open="active-example">Aktives Beispiel öffnen</button>
      <button type="button" data-task-family-open="error-cases">Gezielte Fehlerfälle öffnen</button>
      <button type="button" data-task-family-open="product">Eigenen Lieferauftrag öffnen</button>
      <button type="button" data-task-family-open="magnifier">Algorithmus-Lupe öffnen</button>
    </div>
  </section>

  <section aria-labelledby="precision-family-title" data-task-family-panel="precision" hidden>
    <h3 id="precision-family-title">Präzisionskontrast</h3>
    <p>{resources.content.activities.find((activity) => activity.id === 'precision-routine')?.instruction}</p>
  </section>
  <section aria-labelledby="active-example-family-title" data-task-family-panel="active-example" hidden>
    <h3 id="active-example-family-title">Aktives Beispiel</h3>
    <p>{resources.content.activities.find((activity) => activity.id === 'active-example')?.instruction}</p>
  </section>
  <section aria-labelledby="error-family-title" data-task-family-panel="error-cases" hidden>
    <h3 id="error-family-title">Gezielte Fehlerfälle</h3>
    <p>{resources.content.activities.find((activity) => activity.id === 'error-comparison')?.instruction}</p>
  </section>
  <section aria-labelledby="product-family-title" data-task-family-panel="product">
    <h3 id="product-family-title">Eigener Lieferauftrag</h3>
    <p>{resources.content.activities.find((activity) => activity.id === 'own-product')?.instruction}</p>
    <div class="command-palette">
      <button type="button" data-open-scenario="product-a">Karte A auswählen</button>
      <button type="button" data-open-scenario="product-b">Karte B auswählen</button>
      <button type="button" data-open-scenario="product-c">Karte C auswählen</button>
    </div>
  </section>

  <section aria-labelledby="extended-workshop-title" data-extended-workshop hidden>
    <h3 id="extended-workshop-title">Zusätzliche Fehlerwerkstatt</h3>
    <p>{resources.content.activities.find((activity) => activity.id === 'extended-repair')?.instruction}</p>
    <button type="button" data-open-scenario="extended-inherited">Zusätzlichen Fehlerfall laden</button>
  </section>

  <section aria-labelledby="scenario-selection-title">
    <h3 id="scenario-selection-title">Aufgabe auswählen</h3>
    <div class="command-palette">
      <button type="button" data-open-scenario="error-order">Fehlerfall Reihenfolge öffnen</button>
      <button type="button" data-open-scenario="error-turn">Fehlerfall Drehung öffnen</button>
      <button type="button" data-open-scenario="error-missing-step">Fehlerfall Fehlender Schritt öffnen</button>
      <button type="button" data-open-scenario="error-repeat-count">Fehlerfall Wiederholungszahl öffnen</button>
    </div>
    <p data-active-scenario>Aktives Beispiel: worked-sequence</p>
  </section>

  <div class="workbench-focus">
    <SemanticModelView robotAssetUrl={robotAssetUrl} description={initialSceneDescription} />

    <section class="algorithm-editor" aria-labelledby="algorithm-editor-title">
      <h3 id="algorithm-editor-title">Grafischer Algorithmuseditor</h3>
      <div class="command-palette" aria-label="Befehle einfügen">
        <button type="button" data-insert-command="pick-up">Nimm auf einfügen</button>
        <button type="button" data-insert-command="move">Gehe einfügen</button>
        <button type="button" data-insert-command="turn-left">Links drehen einfügen</button>
        <button type="button" data-insert-command="turn-right">Rechts drehen einfügen</button>
        <button type="button" data-insert-command="drop">Lege ab einfügen</button>
        <button type="button" data-insert-command="repeat">Wiederholung einfügen</button>
      </div>
      <ol aria-label="Algorithmus" data-algorithm-list></ol>
      <p data-empty-algorithm>Noch keine Anweisung eingefügt.</p>
      <p role="alert" data-editor-error hidden></p>
    </section>
  </div>

  <PredictionForm positions={positions} />
  <EvidenceView />
  <EvidenceFeedback />
  {comparisonCheckpoint && (
    <TeacherCheckpoint checkpoint={comparisonCheckpoint}>
      <RoleExchange checkpointId={comparisonCheckpoint.id} contextLabel={comparisonCheckpoint.purpose} />
      <SharedHold checkpointId={comparisonCheckpoint.id} contextLabel={comparisonCheckpoint.purpose} />
    </TeacherCheckpoint>
  )}

  <section aria-labelledby="revision-title">
    <h3 id="revision-title">Abweichung erklären und reparieren</h3>
    <div class="field">
      <label for="repair-hypothesis">Reparaturhypothese</label>
      <textarea id="repair-hypothesis" rows="4" maxlength="500" aria-describedby="repair-status"></textarea>
    </div>
    <button type="button" data-repair-confirm aria-describedby="repair-status">Reparaturhypothese bestätigen</button>
    <p id="repair-status" role="alert" data-repair-status></p>
    <button type="button" data-revision-confirm>Revision übernehmen</button>
    <section aria-labelledby="preserved-draft-title" data-preserved-product hidden>
      <h4 id="preserved-draft-title">Unveränderter eigener Entwurf</h4>
      <pre data-preserved-draft></pre>
    </section>
    <div class="field">
      <label for="loop-decision">Begründung zur festen Wiederholung</label>
      <textarea id="loop-decision" rows="3" maxlength="1000"></textarea>
    </div>
    <button type="button" data-loop-confirm>Schleifenentscheidung bestätigen</button>
    <p role="status" data-loop-status></p>
    <button type="button" data-strategy-hint hidden>Strategiehinweis öffnen</button>
    <section aria-labelledby="strategy-title" data-strategy-content hidden>
      <h4 id="strategy-title">Strategiehinweis</h4>
      <p>Vergleiche die letzte passende mit der ersten abweichenden Spurzeile.</p>
      <button type="button" data-full-example-open>Vollständiges Beispiel anzeigen</button>
    </section>
    <section aria-labelledby="full-example-title" data-full-example hidden>
      <h4 id="full-example-title">Vollständiges Beispiel</h4>
      <p data-full-example-text></p>
    </section>
  </section>
  <RevisionCompare />
  <EvidenceCardComposer
    sourceOptions={evidenceSourceOptions}
    evidenceOptions={evidenceReferenceOptions}
  />
  <SupportDisclosure supports={experience?.supports ?? []} />

  <div data-task-family-panel="magnifier">
    <TransferPrompt cases={transferCases} />
  </div>
  {transferCheckpoint && (
    <TeacherCheckpoint checkpoint={transferCheckpoint}>
      <RoleExchange checkpointId={transferCheckpoint.id} contextLabel={transferCheckpoint.purpose} />
      <SharedHold checkpointId={transferCheckpoint.id} contextLabel={transferCheckpoint.purpose} />
    </TeacherCheckpoint>
  )}
  <ReentryRecall />

  <section aria-labelledby="self-check-title">
    <h3 id="self-check-title">Selbstcheck</h3>
    <div class="self-check-grid">
      {resources.content.selfCheckQuestions.map((question) => (
        <div class="field">
          <label for={`self-check-${question.id}`}>{question.text}</label>
          <select
            id={`self-check-${question.id}`}
            aria-label={selfCheckLabels[question.id]}
            data-self-check-id={question.id}
          >
            <option value="review">Noch prüfen</option>
            <option value="yes">Ja</option>
            <option value="not-applicable">Nicht zutreffend</option>
          </select>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="local-state-title">
    <h3 id="local-state-title">Lokaler Arbeitsstand</h3>
    <p data-save-status role="status">Wird vorbereitet</p>
    <p data-state-error role="alert" hidden></p>
    <p id="ium5-export-sensitivity-hint">
      Exportdateien können Freitext oder Lernprodukte enthalten. Prüfe sie vor dem
      Teilen und veröffentliche sie nicht ungeprüft.
    </p>
    <div class="actions">
      <button type="button" aria-describedby="ium5-export-sensitivity-hint" data-workbench-export>
        Arbeitsstand exportieren
      </button>
      <label class="file-action">
        Importdatei auswählen
        <input type="file" accept="application/json,.json" data-workbench-import />
      </label>
      <button type="button" class="danger" data-workbench-delete>Arbeitsstand löschen</button>
    </div>
  </section>

  <section class="copy-fallback" aria-labelledby="ium5-copy-title" data-copy-fallback hidden>
    <h3 id="ium5-copy-title">Export kopieren</h3>
    <p>Der Dateidownload ist blockiert. Kopiere denselben validierten Inhalt.</p>
    <label for="ium5-copy-text">Export zum Kopieren</label>
    <textarea id="ium5-copy-text" rows="8" readonly data-copy-fallback-text></textarea>
  </section>

  <dialog aria-labelledby="ium5-import-dialog-title" data-import-dialog>
    <h3 id="ium5-import-dialog-title">Import prüfen</h3>
    <dl>
      <dt>Modul</dt><dd data-preview-module></dd>
      <dt>Version</dt><dd data-preview-version></dd>
      <dt>Gespeichert</dt><dd data-preview-saved></dd>
      <dt>Felder</dt><dd data-preview-fields></dd>
    </dl>
    <div class="actions">
      <button type="button" data-import-confirm>Import übernehmen</button>
      <button type="button" data-import-cancel>Abbrechen</button>
    </div>
  </dialog>

  <dialog aria-labelledby="ium5-delete-dialog-title" data-delete-dialog>
    <h3 id="ium5-delete-dialog-title">Arbeitsstand löschen?</h3>
    <p>Der aktive lokale Arbeitsstand wird nach Bestätigung entfernt.</p>
    <div class="actions">
      <button type="button" class="danger" data-delete-confirm>Löschen bestätigen</button>
      <button type="button" data-delete-cancel>Abbrechen</button>
    </div>
  </dialog>

  <dialog aria-labelledby="ium5-scenario-dialog-title" data-scenario-dialog>
    <h3 id="ium5-scenario-dialog-title">Aufgabe wechseln?</h3>
    <p>Der Wechsel verwirft die aktuelle Vorhersage und die zugehörigen Produktspuren.</p>
    <div class="actions">
      <button type="button" data-scenario-confirm>Wechsel bestätigen</button>
      <button type="button" data-scenario-cancel>Abbrechen</button>
    </div>
  </dialog>

  <script is:inline type="application/json" data-workbench-resources set:html={resourceJson}></script>
    </FocusStage>
    <ActionEdge
      slot="action"
      primary={{
        id: 'workbench-run-all',
        label: 'Vollständig ausführen',
        result: 'Führt den bestätigten Algorithmus aus und öffnet die Laufspur.',
      }}
      secondary={[]}
      ariaLabel="Ausführung steuern"
    >
      <button
        slot="primary-control"
        id="workbench-run-all"
        type="button"
        data-run-all
        aria-describedby="workbench-run-all-result"
        disabled
      >Vollständig ausführen</button>
      <button slot="secondary-controls" type="button" data-run-step disabled>
        Schritt ausführen
      </button>
    </ActionEdge>
  </ExperienceShell>
  </div>
</section>

<script>
  import { connectAlgorithmWorkbench } from '../controllers/algorithm-workbench/workbench-controller.js';
  void connectAlgorithmWorkbench();
</script>
